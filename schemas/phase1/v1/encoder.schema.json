{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entor.net/schemas/hippocampus-foundation/phase1/v1/encoder.schema.json",
  "title": "Phase 1 frozen encoder evidence",
  "oneOf": [
    { "$ref": "#/$defs/spec" },
    { "$ref": "#/$defs/verification" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^[^/].*$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_kind", "encoder_id", "model_id", "revision", "bakeoff_report_sha256", "bakeoff_decision", "assets", "dimension", "pooling", "normalize_embeddings", "default_context_tokens", "maximum_context_tokens", "input_recipe", "execution_policy", "licence_review_id"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_kind": { "const": "encoder_spec" },
        "encoder_id": { "const": "gte-modernbert-base-frozen-v1" },
        "model_id": { "const": "Alibaba-NLP/gte-modernbert-base" },
        "revision": { "const": "e7f32e3c00f91d699e8c43b53106206bcc72bb22" },
        "bakeoff_report_sha256": { "$ref": "#/$defs/digest" },
        "bakeoff_decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sample_pages", "selected_context", "weighted_score", "adjacent_hop_auc", "neighbour_recall_at_50", "collision_rate"],
          "properties": {
            "sample_pages": { "const": 40000 },
            "selected_context": { "const": 2048 },
            "weighted_score": { "type": "number", "minimum": 0, "maximum": 1 },
            "adjacent_hop_auc": { "type": "number", "minimum": 0, "maximum": 1 },
            "neighbour_recall_at_50": { "type": "number", "minimum": 0, "maximum": 1 },
            "collision_rate": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "assets": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/asset" } },
        "dimension": { "const": 768 },
        "pooling": { "const": "CLS" },
        "normalize_embeddings": { "const": false },
        "default_context_tokens": { "const": 2048 },
        "maximum_context_tokens": { "const": 8192 },
        "input_recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields", "separator", "truncation", "chunking"],
          "properties": {
            "fields": { "const": ["title", "body"] },
            "separator": { "const": "\n\n" },
            "truncation": { "const": "tokenizer_total_budget" },
            "chunking": { "const": false }
          }
        },
        "execution_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local_files_only", "trust_remote_code", "inference_mode", "gradients_enabled", "weights_mutable"],
          "properties": {
            "local_files_only": { "const": true },
            "trust_remote_code": { "const": false },
            "inference_mode": { "const": true },
            "gradients_enabled": { "const": false },
            "weights_mutable": { "const": false }
          }
        },
        "licence_review_id": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_kind", "encoder_id", "spec_sha256", "snapshot_id", "revision", "bakeoff_report_sha256", "assets", "asset_set_exact", "executable_model_code_files", "verified_at", "verified"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_kind": { "const": "encoder_verification" },
        "encoder_id": { "const": "gte-modernbert-base-frozen-v1" },
        "spec_sha256": { "$ref": "#/$defs/digest" },
        "snapshot_id": { "type": "string", "minLength": 1 },
        "revision": { "const": "e7f32e3c00f91d699e8c43b53106206bcc72bb22" },
        "bakeoff_report_sha256": { "$ref": "#/$defs/digest" },
        "assets": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/asset" } },
        "asset_set_exact": { "type": "boolean" },
        "executable_model_code_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "verified_at": { "type": "string", "format": "date-time" },
        "verified": { "type": "boolean" }
      }
    }
  }
}
