{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entor.net/schemas/hippocampus-foundation/phase1/v1/objective-example.schema.json",
  "title": "Phase 1 development objective example",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "example_id", "objective_family", "selection_stage", "graph_snapshot_sha256", "quarantine_index_sha256", "prompt", "candidates", "target_candidate_id", "generator_id", "generator_seed", "provenance_refs"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "record_kind": { "const": "objective_example" },
    "example_id": { "type": "string", "minLength": 1 },
    "objective_family": {
      "enum": [
        "masked_node_attribute",
        "masked_edge_direction",
        "masked_qualifier_value",
        "evidence_span_alignment",
        "local_entity_disambiguation",
        "bounded_path_continuation",
        "neighbourhood_ranking",
        "source_time_conditioned_retrieval"
      ]
    },
    "selection_stage": { "const": "development" },
    "graph_snapshot_sha256": { "$ref": "#/$defs/digest" },
    "quarantine_index_sha256": { "$ref": "#/$defs/digest" },
    "prompt": { "type": "object" },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "target_candidate_id": { "type": "string", "minLength": 1 },
    "generator_id": { "type": "string", "minLength": 1 },
    "generator_seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "provenance_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "value", "source_version", "artifact_sha256"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "value": { "type": "string", "minLength": 1 },
        "source_version": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "value", "is_target", "negative_basis", "evidence_refs"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "value": {},
        "is_target": { "type": "boolean" },
        "negative_basis": {
          "type": ["string", "null"],
          "enum": [null, "explicit_contradiction", "type_incompatible", "direction_swap", "observed_alternative", "wrong_observed_branch", "source_mismatch", "time_mismatch", "rank_dominated"]
        },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } }
      }
    }
  }
}
