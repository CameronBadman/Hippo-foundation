{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://entor.net/schemas/hippocampus-foundation/phase2/v2/registry.schema.json", "title": "Phase 2 v2 training-source registry",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "registry_kind", "registry_id", "created_at", "required_compatibility", "sources"],
  "properties": {"schema_version": {"const": "2.0.0"}, "registry_kind": {"const": "training_sources"}, "registry_id": {"$ref": "#/$defs/id"}, "created_at": {"type": "string", "format": "date-time"}, "required_compatibility": {"const": "commercial"}, "sources": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/source"}}},
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]+$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rights": {"type": "object", "additionalProperties": false, "required": ["licence_review_id", "provenance_basis", "review_status", "commercial_compatibility"], "properties": {"licence_review_id": {"$ref": "#/$defs/id"}, "provenance_basis": {"const": "first_party_procedural"}, "review_status": {"enum": ["pending", "approved", "rejected"]}, "commercial_compatibility": {"enum": ["intended_pending_review", "verified", "incompatible"]}}},
    "legacyDependencies": {"type": "object", "additionalProperties": false, "required": ["grammar", "world", "relation_composition", "seed_family"], "properties": {"grammar": {"$ref": "#/$defs/id"}, "world": {"$ref": "#/$defs/id"}, "relation_composition": {"$ref": "#/$defs/id"}, "seed_family": {"$ref": "#/$defs/id"}}},
    "processDependencies": {"type": "object", "additionalProperties": false, "required": ["operation", "grammar", "world", "relation_composition", "entity_family", "seed_family"], "properties": {"operation": {"$ref": "#/$defs/id"}, "grammar": {"$ref": "#/$defs/id"}, "world": {"$ref": "#/$defs/id"}, "relation_composition": {"$ref": "#/$defs/id"}, "entity_family": {"$ref": "#/$defs/id"}, "seed_family": {"$ref": "#/$defs/id"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["source_id", "dataset_family", "role", "resolved_version", "generator_id", "generator_spec_sha256", "artifact_sha256", "rights", "admission_state", "blockers", "dependency_families", "training_authorized"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "dataset_family": {"$ref": "#/$defs/id"}, "role": {"enum": ["training", "development", "diagnostic", "confirmatory"]}, "resolved_version": {"type": "string", "minLength": 1}, "generator_id": {"$ref": "#/$defs/id"}, "generator_spec_sha256": {"$ref": "#/$defs/digest"}, "artifact_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "rights": {"$ref": "#/$defs/rights"}, "admission_state": {"enum": ["declared", "admitted", "retired"]}, "blockers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "dependency_families": {"oneOf": [{"$ref": "#/$defs/legacyDependencies"}, {"$ref": "#/$defs/processDependencies"}]}, "training_authorized": {"const": false}}}
  }
}
