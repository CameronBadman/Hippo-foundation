{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entor.net/schemas/hippocampus-foundation/phase2/v2/write-policy-example.schema.json",
  "title": "Phase 2 v2 write-policy example",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_kind", "example_id", "source_id", "role", "snapshot", "proposal", "candidate_frontier", "visible_evidence_ids", "scope", "risk_policy", "candidates", "target", "dependencies", "quarantine", "provenance", "snapshot_sha256", "input_sha256", "training_authorized"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "record_kind": {"const": "write_policy_example"}, "example_id": {"$ref": "#/$defs/id"}, "source_id": {"$ref": "#/$defs/id"}, "role": {"enum": ["training", "development"]},
    "snapshot": {"$ref": "process-state.schema.json"}, "proposal": {"$ref": "proposal.schema.json"},
    "candidate_frontier": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/candidate"}},
    "visible_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["scope_id", "status"], "properties": {"scope_id": {"$ref": "#/$defs/id"}, "status": {"enum": ["in_scope", "out_of_scope", "unknown"]}}},
    "risk_policy": {"$ref": "generator-spec.schema.json#/$defs/riskPolicy"},
    "candidates": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/action"}},
    "target": {"$ref": "#/$defs/target"}, "dependencies": {"$ref": "#/$defs/dependencies"}, "quarantine": {"$ref": "#/$defs/quarantine"}, "provenance": {"$ref": "#/$defs/provenance"},
    "snapshot_sha256": {"$ref": "#/$defs/digest"}, "input_sha256": {"$ref": "#/$defs/digest"}, "training_authorized": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]+$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "action": {"enum": ["attach", "update", "deprecate", "new_node", "duplicate", "conflict", "stage", "ignore"]},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "target_kind", "target_id", "identity_match", "scope_status"], "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "target_kind": {"enum": ["node", "edge"]}, "target_id": {"$ref": "#/$defs/id"}, "identity_match": {"enum": ["exact", "compatible", "ambiguous", "none"]}, "scope_status": {"enum": ["in_scope", "out_of_scope", "unknown"]}}},
    "operation": {"type": "object", "additionalProperties": false, "required": ["collection", "record_id", "before", "after"], "properties": {"collection": {"enum": ["nodes", "edges", "staged_proposals", "decision_records"]}, "record_id": {"$ref": "#/$defs/id"}, "before": {"oneOf": [{"type": "object"}, {"type": "null"}]}, "after": {"oneOf": [{"type": "object"}, {"type": "null"}]}}},
    "patch": {"type": "object", "additionalProperties": false, "required": ["patch_id", "base_snapshot_sha256", "operations", "inverse_operations", "result_snapshot_sha256"], "properties": {"patch_id": {"$ref": "#/$defs/id"}, "base_snapshot_sha256": {"$ref": "#/$defs/digest"}, "operations": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/operation"}}, "inverse_operations": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/operation"}}, "result_snapshot_sha256": {"$ref": "#/$defs/digest"}}},
    "condition": {"type": "object", "additionalProperties": false, "required": ["kind", "subject", "expected"], "properties": {"kind": {"enum": ["snapshot_hash", "record_absent", "record_hash", "invariant"]}, "subject": {"type": "string", "minLength": 1}, "expected": {"type": "string", "minLength": 1}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["action", "patch", "preconditions", "postconditions", "evidence_ids", "cost_record", "rollback"], "properties": {"action": {"$ref": "#/$defs/action"}, "patch": {"oneOf": [{"$ref": "#/$defs/patch"}, {"type": "null"}]}, "preconditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}, "postconditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}, "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "cost_record": {"type": "object", "additionalProperties": false, "required": ["error_class", "cost"], "properties": {"error_class": {"enum": ["unsupported_write", "cross_scope_write", "false_deprecation", "false_identity_merge", "cycle_violation", "missed_valid_write", "unnecessary_ignore", "unnecessary_stage"]}, "cost": {"type": "integer", "minimum": 0, "maximum": 1000000}}}, "rollback": {"type": "object", "additionalProperties": false, "required": ["kind", "restored_snapshot_sha256"], "properties": {"kind": {"enum": ["inverse_patch", "identity"]}, "restored_snapshot_sha256": {"$ref": "#/$defs/digest"}}}}},
    "dependencies": {"type": "object", "additionalProperties": false, "required": ["operation_id", "grammar_id", "world_id", "relation_composition_id", "entity_family_id", "seed_family_id", "template_id", "entity_ids"], "properties": {"operation_id": {"$ref": "#/$defs/id"}, "grammar_id": {"$ref": "#/$defs/id"}, "world_id": {"$ref": "#/$defs/id"}, "relation_composition_id": {"$ref": "#/$defs/id"}, "entity_family_id": {"$ref": "#/$defs/id"}, "seed_family_id": {"$ref": "#/$defs/id"}, "template_id": {"$ref": "#/$defs/id"}, "entity_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "quarantine": {"type": "object", "additionalProperties": false, "required": ["index_id", "index_sha256", "decision", "reasons"], "properties": {"index_id": {"$ref": "#/$defs/id"}, "index_sha256": {"$ref": "#/$defs/digest"}, "decision": {"const": "clear"}, "reasons": {"type": "array", "maxItems": 0, "items": {"type": "string"}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["generator_id", "algorithm_id", "spec_sha256", "rights_binding_id", "seed", "ordinal"], "properties": {"generator_id": {"const": "hf-process-state-v1"}, "algorithm_id": {"const": "immutable-staged-write-generator-v1"}, "spec_sha256": {"$ref": "#/$defs/digest"}, "rights_binding_id": {"$ref": "#/$defs/id"}, "seed": {"$ref": "#/$defs/count"}, "ordinal": {"$ref": "#/$defs/count"}}}
  }
}
