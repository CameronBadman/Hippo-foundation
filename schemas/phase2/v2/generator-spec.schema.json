{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entor.net/schemas/hippocampus-foundation/phase2/v2/generator-spec.schema.json",
  "title": "Phase 2 v2 process generator specification",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_kind", "spec_id", "created_at", "source_id", "role", "generator_id", "algorithm_id", "template_set_id", "seed", "example_count", "dependency_families", "rights_binding_id", "quarantine_policy_id", "bounds", "risk_policy", "shortcut_policy", "training_authorized"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "record_kind": {"const": "process_generator_spec"}, "spec_id": {"$ref": "#/$defs/id"}, "created_at": {"type": "string", "format": "date-time"},
    "source_id": {"$ref": "#/$defs/id"}, "role": {"enum": ["training", "development"]}, "generator_id": {"const": "hf-process-state-v1"},
    "algorithm_id": {"const": "immutable-staged-write-generator-v1"}, "template_set_id": {"const": "process-transition-neutral-v1"},
    "seed": {"$ref": "#/$defs/count"}, "example_count": {"type": "integer", "minimum": 32, "maximum": 8192, "multipleOf": 32},
    "dependency_families": {"$ref": "#/$defs/dependencies"}, "rights_binding_id": {"$ref": "#/$defs/id"}, "quarantine_policy_id": {"const": "phase0-v2-exact-and-near-match"},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["max_candidates", "max_patch_operations", "max_nodes", "max_edges"], "properties": {"max_candidates": {"type": "integer", "minimum": 1, "maximum": 64}, "max_patch_operations": {"type": "integer", "minimum": 1, "maximum": 64}, "max_nodes": {"type": "integer", "minimum": 1, "maximum": 256}, "max_edges": {"type": "integer", "minimum": 1, "maximum": 512}}},
    "risk_policy": {"$ref": "#/$defs/riskPolicy"},
    "shortcut_policy": {"type": "object", "additionalProperties": false, "required": ["method", "maximum_restricted_accuracy"], "properties": {"method": {"const": "leave-one-snapshot-out-v1"}, "maximum_restricted_accuracy": {"const": 0.5}}},
    "training_authorized": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]+$"}, "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "cost": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "dependencies": {"type": "object", "additionalProperties": false, "required": ["operation", "grammar", "world", "relation_composition", "entity_family", "seed_family"], "properties": {"operation": {"$ref": "#/$defs/id"}, "grammar": {"$ref": "#/$defs/id"}, "world": {"$ref": "#/$defs/id"}, "relation_composition": {"$ref": "#/$defs/id"}, "entity_family": {"$ref": "#/$defs/id"}, "seed_family": {"$ref": "#/$defs/id"}}},
    "riskPolicy": {"type": "object", "additionalProperties": false, "required": ["policy_id", "direct_write_max_risk", "error_costs"], "properties": {"policy_id": {"const": "write-conservative-v1"}, "direct_write_max_risk": {"const": "medium"}, "error_costs": {"type": "object", "additionalProperties": false, "required": ["unsupported_write", "cross_scope_write", "false_deprecation", "false_identity_merge", "cycle_violation", "missed_valid_write", "unnecessary_ignore", "unnecessary_stage"], "properties": {"unsupported_write": {"const": 100}, "cross_scope_write": {"const": 100}, "false_deprecation": {"const": 100}, "false_identity_merge": {"const": 80}, "cycle_violation": {"const": 80}, "missed_valid_write": {"const": 20}, "unnecessary_ignore": {"const": 10}, "unnecessary_stage": {"const": 5}}}}}
  }
}
