pe": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "training_authorized": {"const": false}}},
    "ledgerEntry": {"type": "object", "additionalProperties": false, "required": ["example_id", "action", "base_snapshot_sha256", "patch_sha256", "forward_snapshot_sha256", "inverse_patch_sha256", "restored_snapshot_sha256", "delta_sha256", "input_unchanged", "rollback_exact"], "properties": {"example_id": {"$ref": "#/$defs/id"}, "action": {"enum": ["attach", "update", "deprecate", "new_node", "duplicate", "conflict", "stage", "ignore"]}, "base_snapshot_sha256": {"$ref": "#/$defs/digest"}, "patch_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "forward_snapshot_sha256": {"$ref": "#/$defs/digest"}, "inverse_patch_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "restored_snapshot_sha256": {"$ref": "#/$defs/digest"}, "delta_sha256": {"$ref": "#/$defs/digest"}, "input_unchanged": {"type": "boolean"}, "rollback_exact": {"type": "boolean"}}},
