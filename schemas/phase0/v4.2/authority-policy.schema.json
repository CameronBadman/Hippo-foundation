{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entor.net/schemas/hippocampus-foundation/phase0/v4.2/authority-policy.schema.json",
  "title": "Entor Workspace internal OAuth authority policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "policy_id",
    "status",
    "workspace_domain",
    "workspace_customer_id_sha256",
    "cloud_project_numbers",
    "oauth_authority_signing_key_fingerprints",
    "acquisition_authority_signing_key_fingerprints",
    "maximum_oauth_authority_days",
    "maximum_acquisition_authority_hours",
    "training_authorized"
  ],
  "properties": {
    "schema_version": { "const": "4.2.0" },
    "record_kind": { "const": "oauth_authority_policy" },
    "policy_id": { "$ref": "#/$defs/identifier" },
    "status": { "enum": ["pending", "approved", "retired"] },
    "workspace_domain": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$" },
    "workspace_customer_id_sha256": { "$ref": "#/$defs/digest" },
    "cloud_project_numbers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{6,30}$" }
    },
    "oauth_authority_signing_key_fingerprints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fingerprint" }
    },
    "acquisition_authority_signing_key_fingerprints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fingerprint" }
    },
    "maximum_oauth_authority_days": { "const": 365 },
    "maximum_acquisition_authority_hours": { "const": 24 },
    "training_authorized": { "const": false }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "fingerprint": { "type": "string", "pattern": "^[0-9A-F]{40,64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]{0,255}$" }
  }
}
