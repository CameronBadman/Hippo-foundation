{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entor.net/schemas/hippocampus-foundation/phase0/v3/control-evidence.schema.json",
  "title": "Phase 0 v3 control evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "source_id",
    "source_registry_sha256",
    "source_entry_sha256",
    "audited_artifacts_sha256",
    "storage_attestation_sha256",
    "licence_assessment_sha256",
    "evidence_bundle_sha256",
    "inventory_sha256s",
    "quarantine_index_sha256",
    "decision",
    "condition",
    "assessed_at",
    "assessor"
  ],
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "record_kind": { "const": "admission_receipt" },
    "source_id": { "type": "string", "minLength": 1 },
    "source_registry_sha256": { "$ref": "#/$defs/digest" },
    "source_entry_sha256": { "$ref": "#/$defs/digest" },
    "audited_artifacts_sha256": { "$ref": "#/$defs/digest" },
    "storage_attestation_sha256": { "$ref": "#/$defs/digest" },
    "licence_assessment_sha256": { "$ref": "#/$defs/digest" },
    "evidence_bundle_sha256": { "$ref": "#/$defs/digest" },
    "inventory_sha256s": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "quarantine_index_sha256": { "$ref": "#/$defs/digest" },
    "decision": { "enum": ["admitted", "rejected"] },
    "condition": { "const": "admitted_with_mandatory_quarantine" },
    "assessed_at": { "type": "string", "format": "date-time" },
    "assessor": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
