{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entor.net/schemas/hippocampus-foundation/phase0/v4/publisher-evidence.schema.json",
  "title": "Phase 0 v4 publisher checksum evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "evidence_id",
    "source_id",
    "artifact_id",
    "source_registry_sha256",
    "artifact_entry_sha256",
    "statement_sha256",
    "statement_bytes",
    "statement_url",
    "resolved_url",
    "statement_format",
    "retrieved_at",
    "max_age_hours",
    "algorithm",
    "value",
    "filename",
    "statement_match_count",
    "verified_at",
    "verifier",
    "contains_source_bytes",
    "training_authorized"
  ],
  "properties": {
    "schema_version": { "const": "4.0.0" },
    "record_kind": { "const": "publisher_checksum_receipt" },
    "evidence_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "source_id": { "type": "string", "minLength": 1 },
    "artifact_id": { "type": "string", "minLength": 1 },
    "source_registry_sha256": { "$ref": "#/$defs/digest" },
    "artifact_entry_sha256": { "$ref": "#/$defs/digest" },
    "statement_sha256": { "$ref": "#/$defs/digest" },
    "statement_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "statement_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "resolved_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "statement_format": { "const": "gnu_checksum_manifest_v1" },
    "retrieved_at": { "$ref": "#/$defs/timestamp" },
    "max_age_hours": { "type": "integer", "minimum": 1, "maximum": 168 },
    "algorithm": { "enum": ["sha1", "sha256"] },
    "value": { "type": "string", "pattern": "^[0-9a-f]+$" },
    "filename": { "type": "string", "minLength": 1 },
    "statement_match_count": { "const": 1 },
    "verified_at": { "$ref": "#/$defs/timestamp" },
    "verifier": { "type": "string", "minLength": 1 },
    "contains_source_bytes": { "const": false },
    "training_authorized": { "const": false }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
