{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entor.net/schemas/hippocampus-foundation/phase0/v4/storage-evidence.schema.json",
  "title": "Phase 0 v4 observation-bound storage evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "locator_id",
    "provider",
    "provider_resource_id",
    "root_resource_id",
    "observed_root",
    "drive_observation_sha256",
    "source_registry_sha256",
    "principal_permission_id_sha256",
    "requested_scope",
    "scope_exact",
    "same_account_human_attested",
    "method",
    "observed_at",
    "bound_at",
    "expires_at",
    "checks",
    "contains_evaluation_content",
    "api_drive_write_authorized",
    "drive_write_performed",
    "verifier",
    "training_authorized"
  ],
  "properties": {
    "schema_version": { "const": "4.0.0" },
    "record_kind": { "const": "storage_attestation" },
    "locator_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "provider": { "const": "google_drive_shared_drive" },
    "provider_resource_id": { "type": "string", "minLength": 3, "maxLength": 512 },
    "root_resource_id": { "type": "string", "minLength": 3, "maxLength": 512 },
    "observed_root": { "type": "string", "pattern": "^/" },
    "drive_observation_sha256": { "$ref": "#/$defs/digest" },
    "source_registry_sha256": { "$ref": "#/$defs/digest" },
    "principal_permission_id_sha256": { "$ref": "#/$defs/digest" },
    "requested_scope": { "const": "https://www.googleapis.com/auth/drive.readonly" },
    "scope_exact": { "const": true },
    "same_account_human_attested": { "const": true },
    "method": { "const": "google_drive_api_v3_authenticated" },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "bound_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unique_shared_drive", "unique_direct_folder", "folder_not_shortcut", "list_get_consistent", "live_drivefs_mount", "identity_stable"],
      "properties": {
        "unique_shared_drive": { "const": true },
        "unique_direct_folder": { "const": true },
        "folder_not_shortcut": { "const": true },
        "list_get_consistent": { "const": true },
        "live_drivefs_mount": { "const": true },
        "identity_stable": { "const": true }
      }
    },
    "contains_evaluation_content": { "const": false },
    "api_drive_write_authorized": { "const": false },
    "drive_write_performed": { "const": false },
    "verifier": { "type": "string", "minLength": 1 },
    "training_authorized": { "const": false }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
