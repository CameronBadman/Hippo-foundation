{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entor.net/schemas/hippocampus-foundation/phase0/v4.3/gate.schema.json",
  "title": "Phase 0 v4.3 Hugging Face staging and publication gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate_id", "evaluated_at", "contracts_frozen",
    "registry_lineage_ready", "evaluation_gate_ready", "staging_ready",
    "acquisition_authority_ready", "acquisition_evidence_ready",
    "artifact_audit_ready", "structural_inventory_ready",
    "publication_clearance_ready", "foundation_publication_ready",
    "foundation_transform_ready", "blockers", "evidence_bindings",
    "training_authorized"
  ],
  "properties": {
    "schema_version": { "const": "4.3.0" },
    "gate_id": { "const": "phase0-hf-public-source-v4.3" },
    "evaluated_at": { "$ref": "#/$defs/timestamp" },
    "contracts_frozen": { "type": "boolean" },
    "registry_lineage_ready": { "type": "boolean" },
    "evaluation_gate_ready": { "type": "boolean" },
    "staging_ready": { "type": "boolean" },
    "acquisition_authority_ready": { "type": "boolean" },
    "acquisition_evidence_ready": { "type": "boolean" },
    "artifact_audit_ready": { "type": "boolean" },
    "structural_inventory_ready": { "type": "boolean" },
    "publication_clearance_ready": { "type": "boolean" },
    "foundation_publication_ready": { "type": "boolean" },
    "foundation_transform_ready": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
    "evidence_bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
    "training_authorized": { "const": false }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "blocker": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "subject_kind", "subject_id"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "subject_kind": { "type": "string", "minLength": 1 },
        "subject_id": { "type": "string", "minLength": 1 }
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "subject_id", "sha256"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "subject_id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
