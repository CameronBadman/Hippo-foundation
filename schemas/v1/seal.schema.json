{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entor.net/schemas/hippocampus-foundation/v1/seal.schema.json",
  "title": "Confirmatory evaluation seal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seal_id", "evaluation_class", "ciphertext_sha256", "artifact_hashes", "public_key_fingerprint", "created_at", "custodian", "record_count", "state"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "seal_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
    "evaluation_class": { "enum": ["confirmatory", "private_transfer"] },
    "ciphertext_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact_hashes": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "uniqueItems": true },
    "public_key_fingerprint": { "type": "string", "pattern": "^[0-9A-F]{40,64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "custodian": { "type": "string", "minLength": 1 },
    "record_count": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["sealed", "consumed", "retired"] }
  }
}
