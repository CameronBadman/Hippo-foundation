{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entor.net/schemas/hippocampus-foundation/publication/v1/destination-policy.schema.json",
  "title": "Hugging Face publication destination policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_kind", "policy_id", "status", "endpoint",
    "repo_id", "repo_type", "revision", "visibility", "baseline_commit",
    "maximum_part_bytes", "metadata_paths", "artifact_paths",
    "excluded_path_prefixes", "training_authorized"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "record_kind": { "const": "hf_destination_policy" },
    "policy_id": { "$ref": "#/$defs/id" },
    "status": { "const": "configured" },
    "endpoint": { "const": "https://huggingface.co" },
    "repo_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "repo_type": { "const": "dataset" },
    "revision": { "const": "main" },
    "visibility": { "const": "public" },
    "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "maximum_part_bytes": { "const": 10737418240 },
    "metadata_paths": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/metadataPath" }
    },
    "artifact_paths": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/artifactPath" }
    },
    "excluded_path_prefixes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "training_authorized": { "const": false }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "path": {
      "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "metadataPath": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "maximum_bytes", "platform_managed"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "maximum_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "platform_managed": { "type": "boolean" }
      }
    },
    "artifactPath": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "path"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/path" }
      }
    }
  }
}
