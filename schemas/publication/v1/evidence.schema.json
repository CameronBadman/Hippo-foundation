{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entor.net/schemas/hippocampus-foundation/publication/v1/evidence.schema.json",
  "title": "Hugging Face public-source publication evidence v1",
  "oneOf": [
    { "$ref": "#/$defs/destinationObservation" },
    { "$ref": "#/$defs/rightsPayload" },
    { "$ref": "#/$defs/rightsReceipt" },
    { "$ref": "#/$defs/obligationManifest" },
    { "$ref": "#/$defs/authorizationPayload" },
    { "$ref": "#/$defs/authorizationReceipt" },
    { "$ref": "#/$defs/artifactManifest" },
    { "$ref": "#/$defs/publicationReceipt" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "fingerprint": { "type": "string", "pattern": "^[0-9A-F]{40,64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]{0,255}$" },
    "path": {
      "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "remoteFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "storage_kind"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "storage_kind": { "enum": ["git", "lfs", "xet", "unknown"] }
      }
    },
    "destinationObservation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "record_kind", "destination_policy_sha256", "endpoint",
        "repo_id", "repo_type", "revision", "visibility", "principal",
        "write_authorized", "anonymous_readable", "head_commit", "observed_at",
        "files", "contains_credentials", "training_authorized"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_kind": { "const": "hf_destination_observation" },
        "destination_policy_sha256": { "$ref": "#/$defs/digest" },
        "endpoint": { "const": "https://huggingface.co" },
        "repo_id": { "type": "string", "minLength": 3 },
        "repo_type": { "const": "dataset" },
        "revision": { "const": "main" },
        "visibility": { "const": "public" },
        "principal": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "write_authorized": { "const": true },
        "anonymous_readable": { "const": true },
        "head_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/remoteFile" } },
        "contains_credentials": { "const": false },
        "training_authorized": { "const": false }
      }
    },
    "obligation": {
      "type": "object", "additionalProperties": false,
      "required": ["obligation_id", "category", "description"],
      "properties": {
        "obligation_id": { "$ref": "#/$defs/id" },
        "category": { "enum": ["attribution", "notice", "share_alike", "marking", "privacy", "takedown", "access_terms", "other"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "findingDisposition": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "disposition", "rationale_document_id"],
      "properties": {
        "finding_id": { "$ref": "#/$defs/id" },
        "disposition": { "enum": ["resolved", "acknowledged_nonblocking"] },
        "rationale_document_id": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "rightsPayload": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "record_kind", "assessment_id", "authority_policy_sha256",
        "destination_policy_sha256", "source_id", "source_entry_sha256",
        "evidence_bundle_sha256", "decision", "commercial_context",
        "licence_identifiers", "allowed_uses", "excluded_uses", "obligations",
        "finding_dispositions", "reviewer_id", "reviewed_at", "valid_until",
        "signing_key_fingerprint", "training_authorized"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_kind": { "const": "publication_rights_assessment_payload" },
        "assessment_id": { "$ref": "#/$defs/id" },
        "authority_policy_sha256": { "$ref": "#/$defs/digest" },
        "destination_policy_sha256": { "$ref": "#/$defs/digest" },
        "source_id": { "$ref": "#/$defs/id" },
        "source_entry_sha256": { "$ref": "#/$defs/digest" },
        "evidence_bundle_sha256": { "$ref": "#/$defs/digest" },
        "decision": { "enum": ["approved", "rejected", "pending"] },
        "commercial_context": { "enum": ["allowed", "prohibited", "unclear"] },
        "licence_identifiers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "allowed_uses": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["acquire", "inventory", "quarantine", "redistribute_source"] }
        },
        "excluded_uses": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["transform", "embed", "inference", "evaluate", "commercial_service", "train", "redistribute_derived", "redistribute_model"] }
        },
        "obligations": { "type": "array", "items": { "$ref": "#/$defs/obligation" } },
        "finding_dispositions": { "type": "array", "items": { "$ref": "#/$defs/findingDisposition" } },
        "reviewer_id": { "type": ["string", "null"], "minLength": 1 },
        "reviewed_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "valid_until": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "signing_key_fingerprint": { "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }] },
        "training_authorized": { "const": false }
      }
    },
    "rightsReceipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "record_kind", "assessment_id", "authority_policy_sha256",
        "destination_policy_sha256", "source_id", "source_entry_sha256",
        "evidence_bundle_sha256", "payload_sha256", "signature_sha256",
        "public_key_sha256", "signing_key_fingerprint", "reviewed_at", "valid_until",
        "redistribute_source_authorized", "training_authorized"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_kind": { "const": "publication_rights_assessment_receipt" },
        "assessment_id": { "$ref": "#/$defs/id" },
        "authority_policy_sha256": { "$ref": "#/$defs/digest" },
        "destination_policy_sha256": { "$ref": "#/$defs/digest" },
        "source_id": { "$ref": "#/$defs/id" },
        "source_entry_sha256": { "$ref": "#/$defs/digest" },
        "evidence_bundle_sha256": { "$ref": "#/$defs/digest" },
        "payload_sha256": { "$ref": "#/$defs/digest" },
        "signature_sha256": { "$ref": "#/$defs/digest" },
        "public_key_sha256": { "$ref": "#/$defs/digest" },
        "signing_key_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "reviewed_at": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "redistribute_source_authorized": { "const": true },
        "training_authorized": { "const": false }
      }
    },
    "implementationRef": {
      "type": "object", "additionalProperties": false,
      "required": ["obligation_id", "evidence_kind", "path", "sha256"],
      "properties": {
        "obligation_id": { "$ref": "#/$defs/id" },
        "evidence_kind": { "enum": ["public_file", "operational_control"] },
        "path": { "oneOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "obligationManifest": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "record_kind", "manifest_id", "rights_receipt_sha256",
        "destination_policy_sha256", "destination_observation_sha256",
        "implementation_refs", "assembled_at", "complete", "training_authorized"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_kind": { "const": "publication_obligation_manifest" },
        "manifest_id": { "$ref": "#/$defs/id" },
        "rights_receipt_sha256": { "$ref": "#/$defs/digest" },
        "destination_policy_sha256": { "$ref": "#/$defs/digest" },
        "destination_observation_sha256": { "$ref": "#/$defs/digest" },
        "implementation_refs": { "type": "array", "items": { "$ref": "#/$defs/implementationRef" } },
        "assembled_at": { "$ref": "#/$defs/timestamp" },
        "complete": { "const": true },
        "training_authorized": { "const": false }
      }
    },
    "authorizationPayload": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "record_kind", "authorization_id", "authority_policy_sha256",
        "destination_policy_sha256", "destination_observation_sha256",
        "source_registry_sha256", "artifact_id", "artifact_entry_sha256",
        "artifact_clearance_sha256", "rights_receipt_sha256", "obligations_sha256",
        "artifact_manifest_sha256",
        "local_bytes", "local_sha1", "local_sha256", "initial_head_commit",
        "authorized_at", "valid_until", "authorizer_id", "signing_key_fingerprint",
        "training_authorized"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_kind": { "const": "publication_authorization_payload" },
        "authorization_id": { "$ref": "#/$defs/id" },
        "authority_policy_sha256": { "$ref": "#/$defs/digest" },
        "destination_policy_sha256": { "$ref": "#/$defs/digest" },
        "destination_observation_sha256": { "$ref": "#/$defs/digest" },
        "source_registry_sha256": { "$ref": "#/$defs/digest" },
        "artifact_id": { "$ref": "#/$defs/id" },
        "artifact_entry_sha256": { "$ref": "#/$defs/digest" },
        "artifact_clearance_sha256": { "$ref": "#/$defs/digest" },
        "rights_receipt_sha256": { "$ref": "#/$defs/digest" },
        "obligations_sha256": { "$ref": "#/$defs/digest" },
        "artifact_manifest_sha256": { "$ref": "#/$defs/digest" },
        "local_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "local_sha1": { "$ref": "#/$defs/sha1" },
        "local_sha256": { "$ref": "#/$defs/sha256hex" },
        "initial_head_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "authorized_at": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "authorizer_id": { "$ref": "#/$defs/id" },
        "signing_key_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "training_authorized": { "const": false }
      }
    },
    "authorizationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "record_kind", "authorization_id", "authority_policy_sha256",
        "destination_policy_sha256", "destination_observation_sha256",
        "payload_sha256", "signature_sha256", "public_key_sha256",
        "signing_key_fingerprint", "artifact_id", "artifact_clearance_sha256",
        "rights_receipt_sha256", "obligations_sha256", "artifact_manifest_sha256",
        "local_bytes", "local_sha1",
        "local_sha256", "initial_head_commit", "authorized_at", "valid_until",
        "training_authorized"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_kind": { "const": "publication_authorization_receipt" },
        "authorization_id": { "$ref": "#/$defs/id" },
        "authority_policy_sha256": { "$ref": "#/$defs/digest" },
        "destination_policy_sha256": { "$ref": "#/$defs/digest" },
        "destination_observation_sha256": { "$ref": "#/$defs/digest" },
        "payload_sha256": { "$ref": "#/$defs/digest" },
        "signature_sha256": { "$ref": "#/$defs/digest" },
        "public_key_sha256": { "$ref": "#/$defs/digest" },
        "signing_key_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "artifact_id": { "$ref": "#/$defs/id" },
        "artifact_clearance_sha256": { "$ref": "#/$defs/digest" },
        "rights_receipt_sha256": { "$ref": "#/$defs/digest" },
        "obligations_sha256": { "$ref": "#/$defs/digest" },
        "artifact_manifest_sha256": { "$ref": "#/$defs/digest" },
        "local_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "local_sha1": { "$ref": "#/$defs/sha1" },
        "local_sha256": { "$ref": "#/$defs/sha256hex" },
        "initial_head_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "authorized_at": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "training_authorized": { "const": false }
      }
    },
    "part": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "path", "offset", "bytes", "sha256"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "path": { "$ref": "#/$defs/path" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 10737418240 },
        "sha256": { "$ref": "#/$defs/sha256hex" }
      }
    },
    "artifactManifest": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "record_kind", "artifact_id", "source_registry_sha256",
        "artifact_entry_sha256", "original_path", "original_bytes", "original_sha1",
        "original_sha256", "maximum_part_bytes", "parts", "reassembly",
        "training_authorized"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_kind": { "const": "publication_artifact_manifest" },
        "artifact_id": { "$ref": "#/$defs/id" },
        "source_registry_sha256": { "$ref": "#/$defs/digest" },
        "artifact_entry_sha256": { "$ref": "#/$defs/digest" },
        "original_path": { "$ref": "#/$defs/path" },
        "original_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "original_sha1": { "$ref": "#/$defs/sha1" },
        "original_sha256": { "$ref": "#/$defs/sha256hex" },
        "maximum_part_bytes": { "const": 10737418240 },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/part" } },
        "reassembly": { "const": "concatenate_parts_in_index_order" },
        "training_authorized": { "const": false }
      }
    },
    "commit": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "commit"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256hex" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 10737418240 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "publicationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "record_kind", "artifact_id", "authorization_receipt_sha256",
        "destination_policy_sha256", "source_registry_sha256", "artifact_entry_sha256",
        "artifact_clearance_sha256", "local_bytes", "local_sha1", "local_sha256",
        "initial_head_commit", "final_head_commit", "manifest_path", "manifest_sha256",
        "commits", "started_at", "completed_at", "anonymous_readable", "complete",
        "recovered_after_unknown_outcome", "training_authorized"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_kind": { "const": "hf_publication_receipt" },
        "artifact_id": { "$ref": "#/$defs/id" },
        "authorization_receipt_sha256": { "$ref": "#/$defs/digest" },
        "destination_policy_sha256": { "$ref": "#/$defs/digest" },
        "source_registry_sha256": { "$ref": "#/$defs/digest" },
        "artifact_entry_sha256": { "$ref": "#/$defs/digest" },
        "artifact_clearance_sha256": { "$ref": "#/$defs/digest" },
        "local_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "local_sha1": { "$ref": "#/$defs/sha1" },
        "local_sha256": { "$ref": "#/$defs/sha256hex" },
        "initial_head_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "final_head_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "manifest_path": { "$ref": "#/$defs/path" },
        "manifest_sha256": { "$ref": "#/$defs/digest" },
        "commits": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/commit" } },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": { "$ref": "#/$defs/timestamp" },
        "anonymous_readable": { "const": true },
        "complete": { "const": true },
        "recovered_after_unknown_outcome": { "type": "boolean" },
        "training_authorized": { "const": false }
      }
    }
  }
}
